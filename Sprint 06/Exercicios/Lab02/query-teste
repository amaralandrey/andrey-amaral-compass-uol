
CREATE EXTERNAL TABLE IF NOT EXISTS meubanco.minhatabela (
  nome STRING,
  sexo CHAR,
  total INT,
  ano INT
  )
  ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe'
WITH SERDEPROPERTIES (
'serialization.format' = ',',
'field.delim' = ','
)
LOCATION 's3://bucket-andrey-us-east-1/';

